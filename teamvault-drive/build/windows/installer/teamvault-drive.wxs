<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="TeamVault Drive"
           Version="1.0.0"
           Manufacturer="TeamVault"
           UpgradeCode="4B3F8A2E-1C7D-4E9F-B2A6-8D5C3E7F1A0B"
           Language="1033"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of TeamVault Drive is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="..\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://teamvault.cloud" />
    <Property Id="ARPURLINFOABOUT" Value="https://teamvault.cloud" />

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- Install directory: C:\Program Files\TeamVault Drive -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="TeamVault Drive" />
    </StandardDirectory>

    <!-- Start Menu folder -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="TeamVault Drive" />
    </StandardDirectory>

    <!-- Desktop -->
    <StandardDirectory Id="DesktopFolder" />

    <!-- Main executable -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="*">
        <File Id="TeamVaultDriveExe"
              Source="..\..\bin\teamvault-drive.exe"
              Name="teamvault-drive.exe"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Start Menu shortcut -->
    <ComponentGroup Id="StartMenuComponents" Directory="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="AppStartMenuShortcut"
                  Name="TeamVault Drive"
                  Description="Sync your TeamVault workspace files"
                  Target="[INSTALLFOLDER]teamvault-drive.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RemoveFolder Id="CleanupStartMenu" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\TeamVault\Drive"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Desktop shortcut -->
    <ComponentGroup Id="DesktopComponents" Directory="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut Id="AppDesktopShortcut"
                  Name="TeamVault Drive"
                  Description="Sync your TeamVault workspace files"
                  Target="[INSTALLFOLDER]teamvault-drive.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU"
                       Key="Software\TeamVault\Drive"
                       Name="desktop"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="ProductFeature" Title="TeamVault Drive" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="StartMenuComponents" />
      <ComponentGroupRef Id="DesktopComponents" />
    </Feature>

  </Package>
</Wix>
