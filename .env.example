# ─────────────────────────────────────────────────────────────────
# TeamVault Community Edition — Environment Variables
# Copy this file to .env.local and fill in all values.
# ─────────────────────────────────────────────────────────────────

# ── Auth0 (v4 SDK) ───────────────────────────────────────────────
# Create an application at https://manage.auth0.com
# Application Type: Regular Web Application
# Allowed Callback URLs: http://localhost:3000/auth/callback
# Allowed Logout URLs:   http://localhost:3000
AUTH0_SECRET=your-32-char-random-secret-here
AUTH0_DOMAIN=YOUR_AUTH0_DOMAIN.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
APP_BASE_URL=http://localhost:3000
# Optional: Auth0 API audience & canonical issuer (for desktop sync app and API token validation)
# AUTH0_AUDIENCE=https://api.teamvault.com
# AUTH0_ISSUER_BASE_URL=https://YOUR_AUTH0_DOMAIN.us.auth0.com/

# ── Supabase ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Modern publishable key (starts with sb_publishable_...) or legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-supabase-anon-key
# Modern master secret key (starts with sb_secret_...) or legacy service_role key
# Note: Supabase is deprecating legacy service_role / anon JWT keys by late 2026.
SUPABASE_SECRET_KEY=sb_secret_your-supabase-secret-key
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-supabase-service-role-key

# ── Object Storage (any S3-compatible provider) ──────────────────
# STORAGE_PROVIDER: r2 | s3 | gcs | wasabi | backblaze | digitalocean | minio | ceph | ibm | custom
STORAGE_PROVIDER=r2
STORAGE_BUCKET_NAME=your-bucket-name
STORAGE_ACCESS_KEY_ID=your-access-key-id
STORAGE_SECRET_ACCESS_KEY=your-secret-access-key
# Provider-specific (presets fill in whatever you leave blank):
#   STORAGE_ENDPOINT         required for minio | ceph | ibm | custom; overrides any preset
#   STORAGE_REGION           required for s3 | wasabi | backblaze | digitalocean | ibm | custom
#   STORAGE_ACCOUNT_ID       r2 only — builds https://<id>.r2.cloudflarestorage.com
#   STORAGE_FORCE_PATH_STYLE "true" | "false" — overrides the provider default
STORAGE_ACCOUNT_ID=your-cloudflare-account-id
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_FORCE_PATH_STYLE=
#
# Examples:
#   Cloudflare R2:      STORAGE_PROVIDER=r2           STORAGE_ACCOUNT_ID=abc123
#   Amazon S3:          STORAGE_PROVIDER=s3           STORAGE_REGION=us-east-1
#   Google Cloud (HMAC):STORAGE_PROVIDER=gcs
#   Wasabi:             STORAGE_PROVIDER=wasabi       STORAGE_REGION=us-east-1
#   Backblaze B2:       STORAGE_PROVIDER=backblaze    STORAGE_REGION=us-west-004
#   DigitalOcean:       STORAGE_PROVIDER=digitalocean STORAGE_REGION=nyc3
#   MinIO (local):      STORAGE_PROVIDER=minio        STORAGE_ENDPOINT=http://localhost:9000
#   Ceph RGW:           STORAGE_PROVIDER=ceph         STORAGE_ENDPOINT=https://rgw.example.com
#   IBM COS:            STORAGE_PROVIDER=ibm          STORAGE_REGION=us-south STORAGE_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
#
# Verify with: npx -y tsx scripts/check-storage.ts
# Set CORS:    npx -y tsx scripts/set-storage-cors.ts

# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_WORKSPACE_ID=your-workspace-uuid

# ── Resend (transactional email) ─────────────────────────────────
# API key from https://resend.com/api-keys (optional, for invites & bypass codes)
RESEND_API_KEY=re_your-resend-api-key
# Verified sender addresses (must match your Resend domain)
EMAIL_FROM_INVITES=TeamVault Invites <invites@yourdomain.com>
EMAIL_FROM_SECURITY=TeamVault Security <security@yourdomain.com>

# ── Master Admin & Maintenance ───────────────────────────────────
# Comma-separated list of emails granted /master-admin access.
# All comparisons are case-insensitive.
# Example: admin1@example.com,admin2@example.com
MASTER_ADMIN_EMAILS=admin@yourdomain.com,admin2@yourdomain.com

# Optional bearer token for internal maintenance cron endpoints (e.g., recycle bin cleanup)
# INTERNAL_CRON_SECRET=your-internal-cron-secret-here

# ── Installation Diagnostic Security ─────────────────────────────
# Set to "true" to disable the public /install-check diagnostic page once initial deployment is verified
# DISABLE_INSTALL_CHECK=true
